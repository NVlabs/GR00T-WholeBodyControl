# Data only: KEY=value, without shell quotes or substitutions.
# Replace with the actual local devices. Left and right must be distinct.
LEFT_DEVICE=/dev/inspire_left
RIGHT_DEVICE=/dev/inspire_right
BAUD=57600
LEFT_ID=1
RIGHT_ID=1
RATE_HZ=50
RUNTIME_SPEED=1000
# Keep the bridge private; forward these ports over SSH from the computer.
COMMAND_ENDPOINT=tcp://127.0.0.1:5561
STATE_ENDPOINT=tcp://127.0.0.1:5562
