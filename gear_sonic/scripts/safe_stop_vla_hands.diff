+_SAFE_STOP_GUARD = []  # SAFESTOP-HANDS: lazily created SafeHandGuard (or None)
+
+
+def _safe_stop_guard():  # SAFESTOP-HANDS
+    """Deploy safe stop (k / voice) -> open the BrainCo hands (safe_stop_hands.py)."""
+    if not _SAFE_STOP_GUARD:
+        try:
+            try:  # copy next to this script ...
+                from safe_stop_hands import get_hand_guard
+            except ImportError:  # ... or the one in the PICO manager package
+                from gear_sonic.scripts.pico_manager_brainco_dexterous.safe_stop_hands import (
+                    get_hand_guard,
+                )
+            _SAFE_STOP_GUARD.append(get_hand_guard("hold"))
+        except Exception as e:  # noqa: BLE001
+            print(f"[BrainCo] safe_stop_hands unavailable ({e}); hands will not open on a safe stop",
+                  flush=True)
+            _SAFE_STOP_GUARD.append(None)
+    return _SAFE_STOP_GUARD[0]
+
+
+def _apply_safe_stop_to_hands(l, r):  # SAFESTOP-HANDS
+    """Override l / r while a safe stop is active (open slowly) or after it (hold open)."""
+    guard = _safe_stop_guard()
+    if guard is None:
+        return l, r
+    out = []
+    for hand, q in (("left", l), ("right", r)):
+        q_safe, overridden = guard.apply(hand, q, _brainco_last_command[hand])
+        if overridden:
+            q = np.asarray(q_safe, dtype=np.float32)
+            # Keep the contact filter and slew history on what was actually sent.
+            _brainco_last_command[hand] = q.copy()
+            _slew_hand_prev[hand] = q.copy()
+        out.append(q)
+    return out[0], out[1]
+
+
+def _safe_stop_hands_idle():  # SAFESTOP-HANDS
+    """Loop paused / no chunk: still open the hands if a safe stop is active."""
+    guard = _safe_stop_guard()
+    if guard is None or not guard.active():
+        return
+    if os.environ.get("HAND_ENABLE", "0") != "1":
+        return
+    last_l, last_r = _brainco_last_command["left"], _brainco_last_command["right"]
+    if last_l is None or last_r is None:
+        return
+    try:
+        l, r = _apply_safe_stop_to_hands(last_l.copy(), last_r.copy())
+        _get_brainco().send_targets_normalized(l, r, dry_run=False)
+    except Exception as e:  # noqa: BLE001
+        print(f"[BrainCo] safe-stop send failed: {e}", flush=True)
+
